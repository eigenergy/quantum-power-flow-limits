#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "usage: qpf-check <case> <policy> <certificate>" >&2
  exit 2
fi

repo_dir=$(cd "$(dirname "$0")/.." && pwd)
model_file=$(mktemp "${TMPDIR:-/tmp}/qpf-model.XXXXXX")
trap 'rm -f "$model_file"' EXIT

python3 "$repo_dir/scripts/qpf_model.py" "$1" >"$model_file"
set +e
"$repo_dir/.lake/build/bin/qpf-check" "$model_file" "$2" "$3"
status=$?
set -e
exit "$status"
