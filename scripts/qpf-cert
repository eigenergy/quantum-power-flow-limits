#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 || $2 != "--out" ]]; then
  echo "usage: qpf-cert <case> --out <certificate>" >&2
  exit 2
fi

repo_dir=$(cd "$(dirname "$0")/.." && pwd)
model_file=$(mktemp "${TMPDIR:-/tmp}/qpf-model.XXXXXX")
trap 'rm -f "$model_file"' EXIT

python3 "$repo_dir/scripts/qpf_model.py" "$1" >"$model_file"
python3 "$repo_dir/scripts/qpf_cert.py" "$model_file" --out "$3"
